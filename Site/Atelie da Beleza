            <div id="grid-arisa-joias" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6"></div>
        </section>

        <!-- VIEW 4: BA BA BELL -->
        <section id="view-ba-ba-bell" class="hidden page-transition space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-white/10 pb-4 gap-3">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-serif-title font-bold gold-text">BA BA BELL Beauty</h2>
                    <p class="text-xs text-gray-300 mt-1">Cuidados com a pele, hidratação profunda e fragrâncias doces irresistíveis.</p>
                </div>
                <span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30 px-3 py-1.5 rounded-full self-start md:self-auto font-bold flex items-center gap-1">
                    <i class="fa-solid fa-heart"></i> Aroma Doce & Textura Suave
                </span>
            </div>
            <div id="grid-ba-ba-bell" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6"></div>
        </section>

        <!-- VIEW 5: SACOLAS PERSONALIZADAS -->
        <section id="view-caixas" class="hidden page-transition space-y-8">
            <div class="text-center max-w-2xl mx-auto space-y-3 px-2">
                <h2 class="text-2xl sm:text-4xl font-serif-title font-bold gold-text">Sacolas Personalizadas Furta-Cor</h2>
                <p class="text-xs sm:text-sm text-gray-300">
                    Crie sua própria embalagem de presente inesquecível. Escolha o modelo e personalize com <strong class="text-amber-300">Letras Douradas Relevadas em CSS</strong> na frente da sacola.
                </p>
            </div>

