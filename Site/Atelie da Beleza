        };

        let cart = [];
        let currentBoxIcon = 'fa-crown';
        let selectedCardId = null;

        window.onload = function() {
            renderAllProducts();
            updateBoxPreview();
        };

        function navigateTo(viewId) {
            const views = ['home', 'ruby-rose', 'arisa-joias', 'ba-ba-bell', 'caixas'];
            views.forEach(v => {
                const el = document.getElementById(`view-${v}`);
                const navBtn = document.getElementById(`nav-${v}`);
                if (el) el.classList.add('hidden');
                if (navBtn) navBtn.classList.remove('active');
            });

            const activeView = document.getElementById(`view-${viewId}`);
            const activeBtn = document.getElementById(`nav-${viewId}`);
            
            if (activeView) activeView.classList.remove('hidden');
            if (activeBtn) activeBtn.classList.add('active');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const icon = document.getElementById('mobile-menu-icon');
            menu.classList.toggle('hidden');
            if (!menu.classList.contains('hidden')) {
                icon.className = 'fa-solid fa-xmark text-lg';
            } else {
                icon.className = 'fa-solid fa-bars text-lg';
            }
        }

        function renderAllProducts() {
            for (const category in productsDB) {
                const container = document.getElementById(`grid-${category}`);
                if (!container) continue;

                container.innerHTML = productsDB[category].map(p => `
                    <div id="card-${p.id}" onclick="selectCard('${p.id}', '${category}')" class="furta-cor-card rounded-2xl overflow-hidden group flex flex-col justify-between border border-white/10 cursor-pointer hover:scale-[1.02]">
                        <div id="badge-select-${p.id}" class="hidden absolute top-3 right-3 z-20 bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 font-extrabold text-[10px] uppercase px-2.5 py-1 rounded-full shadow-lg border border-white/40 flex items-center gap-1 animate-bounce">
                            <i class="fa-solid fa-sparkles"></i> Selecionado
                        </div>

                        <div>
                            <div class="relative overflow-hidden h-48 sm:h-52 bg-slate-800">
                                <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                <button onclick="event.stopPropagation(); openProductModal('${p.id}', '${category}')" class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-semibold text-xs gap-2">
                                    <i class="fa-solid fa-eye text-amber-300"></i> Espiar Detalhes
                                </button>
                            </div>
                            <div class="p-4 sm:p-5 space-y-1.5">
                                <span class="text-[10px] uppercase font-bold gold-text tracking-widest">${p.brand}</span>
                                <h4 class="font-bold text-white text-xs sm:text-sm line-clamp-1 group-hover:text-amber-200 transition">${p.name}</h4>
                                <p class="text-[11px] sm:text-xs text-gray-400 line-clamp-2">${p.desc}</p>
                            </div>
                        </div>
                        <div class="p-4 sm:p-5 pt-0 flex items-center justify-between border-t border-white/5 mt-2">
                            <span class="text-base sm:text-lg font-bold gold-text-glow">R$ ${p.price.toFixed(2).replace('.', ',')}</span>
                            <button onclick="event.stopPropagation(); addToCart('${p.id}', '${category}')" class="btn-gold p-2.5 rounded-xl text-xs flex items-center gap-1.5 shadow">
                                <i class="fa-solid fa-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function selectCard(id, category) {
            if (selectedCardId && document.getElementById(`card-${selectedCardId}`)) {
                const prevCard = document.getElementById(`card-${selectedCardId}`);
                const prevBadge = document.getElementById(`badge-select-${selectedCardId}`);
                prevCard.classList.remove('card-selected');
                if (prevBadge) prevBadge.classList.add('hidden');
            }

            selectedCardId = id;
            const currentCard = document.getElementById(`card-${id}`);
            const currentBadge = document.getElementById(`badge-select-${id}`);

            if (currentCard) {
                currentCard.classList.add('card-selected');
                if (currentBadge) currentBadge.classList.remove('hidden');
            }

            const product = productsDB[category].find(p => p.id === id);
            if (product) {
                showToast('Item Selecionado', `${product.name} destacado.`);
            }
        }

        function openProductModal(id, category) {
            const product = productsDB[category].find(p => p.id === id);
            if (!product) return;

            document.getElementById('modal-img').src = product.image;
            document.getElementById('modal-brand').innerText = product.brand;
            document.getElementById('modal-title').innerText = product.name;
            document.getElementById('modal-desc').innerText = product.desc;
            document.getElementById('modal-price').innerText = `R$ ${product.price.toFixed(2).replace('.', ',')}`;
            
            const addBtn = document.getElementById('modal-add-btn');
            addBtn.onclick = function() {
                addToCart(product.id, category);
                closeProductModal();
            };

            document.getElementById('product-modal').classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        function updateBoxPreview() {
            const inputVal = document.getElementById('input-box-text').value;
            const previewText = document.getElementById('box-text-preview');
            previewText.innerText = inputVal.trim() !== '' ? inputVal : 'SEU NOME AQUI';
        }

        function setBoxIcon(iconClass) {
            currentBoxIcon = iconClass;
            const iconEl = document.getElementById('box-icon-preview');
            iconEl.className = `fa-solid ${iconClass} text-3xl sm:text-4xl text-amber-300 mb-3 sm:mb-4 filter drop-shadow`;
        }

        function updateBoxPrice() {
            const select = document.getElementById('select-box-size');
            const price = parseFloat(select.value);
            document.getElementById('box-price-display').innerText = `R$ ${price.toFixed(2).replace('.', ',')}`;
        }

        function addCustomBoxToCart() {
            const inputVal = document.getElementById('input-box-text').value.trim() || 'ATELIÊ DA BELEZA';
            const select = document.getElementById('select-box-size');
            const price = parseFloat(select.value);
            const sizeName = select.options[select.selectedIndex].getAttribute('data-name');

            const customBoxItem = {
                id: 'box-' + Date.now(),
                brand: 'Ateliê Personalizados',
                name: `Sacola Furta-Cor [${inputVal.toUpperCase()}]`,
                price: price,
                desc: `${sizeName} gravada em Letras Douradas com o texto "${inputVal}".`,
                quantity: 1
            };

            cart.push(customBoxItem);
            updateCartUI();
            showToast('Sacola Personalizada!', `Gravada com "${inputVal}" adicionada.`);
        }

        function addToCart(id, category) {
            const product = productsDB[category].find(p => p.id === id);
            if (!product) return;

            const existingIndex = cart.findIndex(item => item.id === id);
            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            showToast('Adicionado à Sacola!', product.name);
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function changeQty(index, delta) {
            if (cart[index]) {
                cart[index].quantity += delta;
                if (cart[index].quantity <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items-container');
            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');

            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            badge.innerText = totalItems;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-16 text-gray-400 space-y-3">
                        <i class="fa-solid fa-bag-shopping text-5xl text-gray-600 animate-pulse"></i>
                        <p class="text-sm font-medium">Sua sacola está vazia no momento.</p>
                        <p class="text-xs text-gray-500">Explore nossas categorias e adicione produtos incríveis.</p>
                    </div>
                `;
                subtotalEl.innerText = 'R$ 0,00';
                totalEl.innerText = 'R$ 0,00';
                return;
            }

            let totalPrice = 0;
            container.innerHTML = cart.map((item, index) => {
                const itemTotal = item.price * item.quantity;
                totalPrice += itemTotal;

                return `
                    <div class="flex items-center justify-between bg-white/5 p-3 sm:p-3.5 rounded-2xl border border-white/10 hover:border-amber-300/30 transition-all">
                        <div class="flex-1 pr-3">
                            <span class="text-[10px] text-amber-300 font-bold uppercase tracking-wider">${item.brand}</span>
                            <h5 class="text-xs font-bold text-white line-clamp-1 mt-0.5">${item.name}</h5>
                            <span class="text-xs text-amber-200 font-semibold mt-1 inline-block">R$ ${item.price.toFixed(2).replace('.', ',')}</span>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <div class="flex items-center bg-black/50 rounded-xl border border-white/10 text-xs px-1">
                                <button onclick="changeQty(${index}, -1)" class="px-2 py-1.5 text-gray-300 hover:text-white transition">-</button>
                                <span class="px-1.5 text-white font-bold">${item.quantity}</span>
                                <button onclick="changeQty(${index}, 1)" class="px-2 py-1.5 text-gray-300 hover:text-white transition">+</button>
                            </div>
                            <button onclick="removeFromCart(${index})" class="text-rose-400 hover:text-rose-300 p-1.5 transition">
                                <i class="fa-solid fa-trash-can text-xs"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            subtotalEl.innerText = `R$ ${totalPrice.toFixed(2).replace('.', ',')}`;
            totalEl.innerText = `R$ ${totalPrice.toFixed(2).replace('.', ',')}`;
            document.getElementById('checkout-total-price').innerText = `R$ ${totalPrice.toFixed(2).replace('.', ',')}`;
        }

        function toggleCart() {
            const modal = document.getElementById('cart-modal');
            modal.classList.toggle('hidden');
        }

        function showToast(title, msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-msg').innerText = msg;

            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-20');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-20');
            }, 3000);
        }

        function openCheckout() {
            if (cart.length === 0) {
                showToast('Sacola Vazia', 'Adicione itens antes de finalizar a compra.');
                return;
            }
            toggleCart();
            document.getElementById('checkout-modal').classList.remove('hidden');
        }

        function closeCheckout() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function copiarChavePix(chave) {
            navigator.clipboard.writeText(chave).then(() => {
                showToast('Chave PIX Copiada!', 'Cole no aplicativo do seu banco para pagar.');
            }).catch(err => {
                console.error('Erro ao copiar a chave PIX: ', err);
            });
        }

        function imprimirComprovante() {
            const agora = new Date();
            const dataFormatada = agora.toLocaleDateString('pt-BR');
            const horaFormatada = agora.toLocaleTimeString('pt-BR');
            const totalCompra = document.getElementById('checkout-total-price').innerText;
            const pedidoId = '#ATLB-' + Math.floor(1000 + Math.random() * 9000);

            const janelaImpressao = window.open('', '_blank', 'width=600,height=700');
            janelaImpressao.document.write(`
                <html>
                <head>
                    <title>Comprovante de Compra - Ateliê da Beleza</title>
                    <style>
                        body { font-family: 'Montserrat', Arial, sans-serif; padding: 30px; color: #111; background: #fff; }
                        .receipt-box { border: 2px dashed #b8860b; padding: 30px; border-radius: 12px; max-width: 450px; margin: auto; }
                        h2 { text-align: center; color: #b8860b; font-family: 'Playfair Display', serif; margin-bottom: 5px; }
                        p { font-size: 13px; margin: 8px 0; }
                        .center { text-align: center; }
                        .bold { font-weight: bold; }
                        .total { font-size: 18px; color: #b8860b; margin-top: 15px; border-top: 1px solid #ddd; padding-top: 10px; }
                        .footer { margin-top: 25px; text-align: center; font-size: 11px; color: #666; }
                    </style>
                </head>
                <body>
                    <div class="receipt-box">
                        <h2>Ateliê da Beleza</h2>
                        <p class="center bold" style="font-size: 11px; color: #555;">COMPROVANTE DE PAGAMENTO</p>
                        <hr style="border: 0; border-top: 1px solid #eee; margin: 15px 0;">
                        <p><span class="bold">Pedido:</span> ${pedidoId}</p>
                        <p><span class="bold">Data:</span> ${dataFormatada}</p>
                        <p><span class="bold">Hora:</span> ${horaFormatada}</p>
                        <div class="total center">
                            Valor Total: <span class="bold">${totalCompra}</span>
                        </div>
                        <div class="footer">
                            <p>Obrigado por comprar no Ateliê da Beleza!</p>
                            <p>© 2026 Ateliê da Beleza • Hades Softwares</p>
                        </div>
                    </div>
                    <script>
                        window.onload = function() { window.print(); window.close(); }
                    <\/script>
                </body>
                </html>
            `);
            janelaImpressao.document.close();
            
            closeCheckout();
            cart = [];
            updateCartUI();
            showToast('Comprovante Gerado!', 'Impressão do comprovante iniciada com sucesso.');
        }

        function finishOrder() {
            cart = [];
            updateCartUI();
            document.getElementById('modal-success').classList.add('hidden');
            navigateTo('home');
        }
    </script>
</body>
</html>
