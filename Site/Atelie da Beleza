                            Ateliê da Beleza
                        </h1>
                        <p class="text-[9px] sm:text-[10px] tracking-widest uppercase text-amber-200/90 -mt-1 font-semibold">Cosméticos & Luxo</p>
                    </div>
                </div>

                <!-- Menu Desktop -->
                <nav class="hidden md:flex space-x-6 lg:space-x-8 text-sm font-medium">
                    <button onclick="navigateTo('home')" id="nav-home" class="nav-btn py-2 gold-text active">Início</button>
                    <button onclick="navigateTo('ruby-rose')" id="nav-ruby-rose" class="nav-btn py-2 gold-text">Ruby Rose</button>
                    <button onclick="navigateTo('arisa-joias')" id="nav-arisa-joias" class="nav-btn py-2 gold-text">Arisa Joias</button>
                    <button onclick="navigateTo('ba-ba-bell')" id="nav-ba-ba-bell" class="nav-btn py-2 gold-text">BA BA BELL</button>
                    <button onclick="navigateTo('caixas')" id="nav-caixas" class="nav-btn py-2 gold-text flex items-center gap-1">
                        <i class="fa-solid fa-bag-shopping text-xs"></i> Sacolas Personalizadas
                    </button>
                </nav>

                <!-- Ações / Carrinho e Menu Mobile -->
                <div class="flex items-center space-x-3">
                    <button onclick="toggleCart()" class="relative p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all transform hover:scale-105 border border-amber-300/30 shadow-lg">
                        <i class="fa-solid fa-shopping-bag text-base sm:text-lg text-amber-300"></i>
                        <span id="cart-badge" class="absolute -top-1 -right-1 bg-gradient-to-r from-pink-500 to-purple-600 text-white text-[10px] sm:text-xs font-bold w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center shadow-md animate-pulse">0</span>
                    </button>
                    
                    <button onclick="toggleMobileMenu()" class="md:hidden p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-amber-300 border border-amber-300/30">
                        <i id="mobile-menu-icon" class="fa-solid fa-bars text-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menu Mobile Dropdown Otimizado -->
        <div id="mobile-menu" class="hidden md:hidden furta-cor-navbar border-b border-amber-300/30 px-5 py-4 space-y-2 shadow-2xl transition-all">
            <button onclick="navigateTo('home'); toggleMobileMenu()" class="block w-full text-left py-2.5 px-3 rounded-xl gold-text font-medium hover:bg-white/10 transition">Início</button>
            <button onclick="navigateTo('ruby-rose'); toggleMobileMenu()" class="block w-full text-left py-2.5 px-3 rounded-xl gold-text font-medium hover:bg-white/10 transition">Ruby Rose</button>
            <button onclick="navigateTo('arisa-joias'); toggleMobileMenu()" class="block w-full text-left py-2.5 px-3 rounded-xl gold-text font-medium hover:bg-white/10 transition">Arisa Joias</button>
            <button onclick="navigateTo('ba-ba-bell'); toggleMobileMenu()" class="block w-full text-left py-2.5 px-3 rounded-xl gold-text font-medium hover:bg-white/10 transition">BA BA BELL</button>
            <button onclick="navigateTo('caixas'); toggleMobileMenu()" class="block w-full text-left py-2.5 px-3 rounded-xl gold-text font-medium hover:bg-white/10 transition flex items-center gap-2"><i class="fa-solid fa-bag-shopping text-amber-300"></i>Sacolas Personalizadas</button>
        </div>
    </header>

    <!-- Notificação Toast -->
    <div id="toast" class="fixed bottom-5 right-4 left-4 sm:left-auto z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="furta-cor-card px-5 py-3.5 rounded-xl border border-amber-300/40 shadow-2xl flex items-center gap-3 bg-slate-900/95 text-white max-w-sm ml-auto">
            <i class="fa-solid fa-circle-check text-emerald-400 text-xl flex-shrink-0"></i>
            <div>
                <p id="toast-title" class="font-bold text-xs sm:text-sm text-amber-200">Adicionado com Sucesso!</p>
                <p id="toast-msg" class="text-[11px] sm:text-xs text-gray-300">O produto já está no seu carrinho.</p>
            </div>
        </div>
    </div>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex-grow w-full">

        <!-- VIEW 1: HOME -->
        <section id="view-home" class="page-transition space-y-10 sm:space-y-12">
            <!-- Hero Banner -->
            <div class="relative rounded-3xl furta-cor-card p-6 sm:p-12 overflow-hidden border border-white/20 text-center sm:text-left flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="space-y-5 max-w-xl z-10">
                    <span class="inline-block px-3.5 py-1 rounded-full bg-white/10 backdrop-blur-md text-[11px] sm:text-xs font-semibold uppercase tracking-widest text-pink-200 border border-white/20">
                        <i class="fa-solid fa-sparkles text-amber-300 mr-1"></i> Coleção Exclusiva Furta-Cor
                    </span>
                    <h2 class="text-2xl sm:text-5xl font-serif-title font-bold text-white leading-tight">
                        Realce Sua Beleza Com <span class="gold-text">Elegância Irresistível</span>
                    </h2>
                    <p class="text-gray-300 text-xs sm:text-base leading-relaxed">
                        Explore marcas renomadas como Ruby Rose, joias artesanais Arisa Joias e cuidados especiais BA BA BELL. Personalize sacolas e caixas presenteáveis com gravação dourada exclusiva.
                    </p>
                    
                    <div class="flex flex-wrap gap-3.5 pt-2 justify-center sm:justify-start">
                        <button onclick="navigateTo('ruby-rose')" class="btn-gold px-7 py-3 rounded-full text-xs sm:text-sm font-bold tracking-wide shadow-lg">
                            Ver Produtos
                        </button>
                        <button onclick="navigateTo('caixas')" class="px-7 py-3 rounded-full text-xs sm:text-sm font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/30 backdrop-blur-md transition-all">
                            Sacolas Sob Medida
                        </button>
                    </div>
                </div>

                <div class="relative z-10 w-56 h-56 sm:w-80 sm:h-80 rounded-2xl custom-box-3d flex items-center justify-center p-5 text-center transform rotate-2 hover:rotate-0 transition-transform duration-500 shadow-2xl flex-shrink-0">
                    <div class="border border-amber-300/60 p-4 rounded-xl w-full h-full flex flex-col items-center justify-center bg-black/20 backdrop-blur-sm">
                        <i class="fa-solid fa-crown text-3xl sm:text-4xl text-amber-300 mb-2 filter drop-shadow"></i>
                        <h3 class="gold-box-engraving text-xl sm:text-2xl font-bold uppercase">Ateliê Luxo</h3>
                        <p class="text-[10px] sm:text-xs text-white/90 font-medium mt-1">Edição Limitada</p>
                    </div>
                </div>
            </div>

            <!-- Destaque / Queima de Estoque -->
            <div class="text-center space-y-2.5 py-2">
                <h2 class="text-xl sm:text-4xl font-serif-title font-bold text-white">
                    Aproveite a <span class="gold-text">Queima de Estoque Ruby Rose</span>
                </h2>
                <p class="text-xs sm:text-sm text-gray-300 max-w-xl mx-auto px-2">Garanta seus itens favoritos com descontos especiais por tempo limitado.</p>
            </div>

            <!-- Categorias em Destaque -->
            <div>
                <h3 class="text-xl sm:text-2xl font-serif-title font-bold text-center mb-6 sm:mb-8 gold-text-glow">Explore Nossas Marcas & Opções</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
                    <!-- Card Ruby Rose -->
                    <div onclick="navigateTo('ruby-rose')" class="furta-cor-card rounded-2xl p-5 sm:p-6 cursor-pointer hover:scale-[1.02] transition-all border border-pink-500/30 group">
                        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-pink-500/20 border border-pink-400/40 flex items-center justify-center mb-4 group-hover:bg-pink-500/40 transition">
                            <i class="fa-solid fa-wand-magic-sparkles text-xl sm:text-2xl text-pink-300"></i>
                        </div>
                        <h4 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-pink-300 transition">Ruby Rose</h4>
                        <p class="text-xs text-gray-300 mb-4">Maquiagens de alta performance, paletas pigmentadas e linhas de cuidados faciais.</p>
                        <span class="text-xs text-amber-300 font-semibold group-hover:underline flex items-center gap-1">Conferir Linha <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                    </div>

                    <!-- Card Arisa Joias -->
                    <div onclick="navigateTo('arisa-joias')" class="furta-cor-card rounded-2xl p-5 sm:p-6 cursor-pointer hover:scale-[1.02] transition-all border border-amber-500/30 group">
                        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center mb-4 group-hover:bg-amber-500/40 transition">
                            <i class="fa-solid fa-gem text-xl sm:text-2xl text-amber-300"></i>
                        </div>
                        <h4 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-amber-200 transition">Arisa Joias</h4>
                        <p class="text-xs text-gray-300 mb-4">Anéis, colares, brincos e pulseiras refinadas em banho de ouro e prata legítima.</p>
                        <span class="text-xs text-amber-300 font-semibold group-hover:underline flex items-center gap-1">Ver Coleção <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                    </div>

                    <!-- Card BA BA BELL -->
                    <div onclick="navigateTo('ba-ba-bell')" class="furta-cor-card rounded-2xl p-5 sm:p-6 cursor-pointer hover:scale-[1.02] transition-all border border-purple-500/30 group">
                        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-purple-500/20 border border-purple-400/40 flex items-center justify-center mb-4 group-hover:bg-purple-500/40 transition">
                            <i class="fa-solid fa-pump-soap text-xl sm:text-2xl text-purple-300"></i>
                        </div>
                        <h4 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-purple-300 transition">BA BA BELL</h4>
                        <p class="text-xs text-gray-300 mb-4">Hidratantes perfumados, gloss labial com aromas doces e body splashes irresistíveis.</p>
                        <span class="text-xs text-amber-300 font-semibold group-hover:underline flex items-center gap-1">Descobrir Linha <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                    </div>

                    <!-- Card Sacolas Personalizadas -->
                    <div onclick="navigateTo('caixas')" class="furta-cor-card rounded-2xl p-5 sm:p-6 cursor-pointer hover:scale-[1.02] transition-all border border-yellow-500/30 group bg-gradient-to-br from-yellow-500/10 to-pink-500/10">
                        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-yellow-500/20 border border-yellow-400/40 flex items-center justify-center mb-4 group-hover:bg-yellow-500/40 transition">
                            <i class="fa-solid fa-bag-shopping text-xl sm:text-2xl text-yellow-300"></i>
                        </div>
                        <h4 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-yellow-200 transition">Sacolas Especiais</h4>
