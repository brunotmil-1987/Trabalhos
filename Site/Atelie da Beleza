<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ateliê da Beleza - Cosméticos & Joias Exclusivas</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Playfair Display & Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #120a1f;
            color: #f3f4f6;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        .font-serif-title {
            font-family: 'Playfair Display', serif;
        }

        .furta-cor-bg {
            background: linear-gradient(135deg, rgba(30, 15, 45, 0.95), rgba(45, 20, 60, 0.95), rgba(18, 25, 50, 0.95), rgba(40, 18, 48, 0.95));
            background-size: 300% 300%;
            animation: furtaCorShift 16s ease infinite;
        }

        .furta-cor-navbar {
            background: linear-gradient(90deg, rgba(255, 182, 193, 0.18), rgba(186, 85, 211, 0.18), rgba(135, 206, 250, 0.18), rgba(255, 228, 196, 0.18), rgba(221, 160, 221, 0.18));
            background-size: 300% 300%;
            animation: furtaCorShift 10s ease infinite;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .furta-cor-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .furta-cor-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
            transform: rotate(30deg);
            pointer-events: none;
            transition: opacity 0.5s;
            opacity: 0.5;
        }

        .furta-cor-card:hover::before {
            opacity: 0.9;
        }

        .furta-cor-card.card-selected {
            border-color: #ffd700 !important;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.6), inset 0 0 15px rgba(255, 215, 0, 0.3) !important;
            transform: translateY(-4px) scale(1.01);
            animation: cardPulseGlow 2s infinite alternate;
        }

        @keyframes cardPulseGlow {
            0% {
                box-shadow: 0 0 15px rgba(255, 215, 0, 0.5), 0 0 30px rgba(186, 85, 211, 0.3);
            }
            100% {
                box-shadow: 0 0 28px rgba(255, 215, 0, 0.9), 0 0 45px rgba(135, 206, 250, 0.6);
            }
        }

        @keyframes furtaCorShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .gold-text {
            background: linear-gradient(110deg, #BF953F 0%, #FCF6BA 20%, #B38728 40%, #FFF8DC 50%, #FBF5B7 60%, #AA771C 80%, #BF953F 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0px 2px 5px rgba(0, 0, 0, 0.8));
            animation: goldShimmer 4s linear infinite;
            font-weight: 700;
        }

        .gold-text-glow {
            background: linear-gradient(110deg, #FFE082 0%, #fff8e1 25%, #FFD700 50%, #FFB300 75%, #FF8F00 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.7));
            animation: goldShimmer 3s linear infinite;
        }

        .gold-box-engraving {
            font-family: 'Playfair Display', serif;
            letter-spacing: 2px;
            background: linear-gradient(90deg, #ffd700 0%, #fff8dc 25%, #daa520 50%, #ffffff 65%, #b8860b 85%, #ffd700 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: goldShimmer 3.5s linear infinite;
            filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.9)) drop-shadow(0 0 8px rgba(255, 215, 0, 0.6));
        }

        @keyframes goldShimmer {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        .nav-btn {
            position: relative;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-btn::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 50%;
            width: 0%;
            height: 2px;
            background: linear-gradient(90deg, #ffd700, #fecfef, #a1c4fd, #ffd700);
            transition: all 0.3s ease;
            transform: translateX(-50%);
            border-radius: 2px;
        }

        .nav-btn:hover::after, .nav-btn.active::after {
            width: 80%;
        }

        .nav-btn:hover, .nav-btn.active {
            transform: translateY(-2px);
        }

        .page-transition {
            animation: fadeInScale 0.4s ease-out forwards;
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.98) translateY(8px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .btn-gold {
            background: linear-gradient(135deg, #ffd700, #fff8dc, #d4af37, #f3e5ab, #aa771c);
            background-size: 200% 200%;
            color: #111;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        .btn-gold:hover {
            background-position: right center;
            box-shadow: 0 6px 22px rgba(255, 215, 0, 0.8);
            transform: translateY(-2px) scale(1.02);
        }

        .custom-box-3d {
            background: linear-gradient(135deg, #ffc3a0 0%, #ffa17f 25%, #e0c3fc 50%, #8ec5fc 75%, #fecfef 100%);
            background-size: 200% 200%;
            animation: furtaCorShift 8s infinite alternate;
            box-shadow: inset 0 0 20px rgba(255,255,255,0.6), 0 20px 40px rgba(0,0,0,0.5);
            border: 3px solid rgba(255, 215, 0, 0.8);
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0d0f17;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #ffd700, #ba55d3, #87cefa);
            border-radius: 4px;
        }
    </style>
</head>
<body class="furta-cor-bg min-h-screen flex flex-col justify-between selection:bg-pink-500 selection:text-white">

    <!-- Header / Navbar Principal -->
    <header class="sticky top-0 z-40 furta-cor-navbar transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                
                <!-- Logo -->
                <div class="flex items-center space-x-2.5 cursor-pointer" onclick="navigateTo('home')">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border-2 border-amber-300 flex items-center justify-center bg-gradient-to-tr from-pink-500/30 to-purple-500/30 shadow-lg shadow-amber-500/20">
                        <i class="fa-solid font-serif text-amber-300 text-lg sm:text-xl font-bold">A</i>
                    </div>
                    <div>
