                        <span class="text-xs text-amber-300 font-semibold group-hover:underline flex items-center gap-1">Personalizar <i class="fa-solid fa-arrow-right text-[10px]"></i></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- VIEW 2: RUBY ROSE -->
        <section id="view-ruby-rose" class="hidden page-transition space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-white/10 pb-4 gap-3">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-serif-title font-bold gold-text">Ruby Rose Cosméticos</h2>
                    <p class="text-xs text-gray-300 mt-1">Linha completa de maquiagens exclusivas, bases, batons e pincéis com preços imperdíveis.</p>
                </div>
                <span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30 px-3 py-1.5 rounded-full self-start md:self-auto font-bold flex items-center gap-1">
