        <!-- VIEW 3: ARISA JOIAS -->
        <section id="view-arisa-joias" class="hidden page-transition space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-white/10 pb-4 gap-3">
                <div>
                    <h2 class="text-2xl sm:text-3xl font-serif-title font-bold gold-text">Arisa Joias Luxo</h2>
