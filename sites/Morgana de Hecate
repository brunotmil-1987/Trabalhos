<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Morgana de Hecate | Oráculo Sagrado</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="Icone-Morgana-cutout.ico">
    <style>
        :root {
            --bg-color: #050507;
            --panel-bg: #0e0e14;
            --border-gold: #c5a059;
            --border-gold-bright: #e6ca84;
            --gold-dark: #8c7131;
            --text-color: #dfdfdf;
            --text-muted: #a0a0a5;
            --accent-glow: rgba(197, 160, 89, 0.25);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cormorant Garamond', serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            position: relative;
            overflow-x: hidden;
        }

        /* Fundo com Estrela de 5 Pontas (Pentagrama) */
        .bg-pentagram {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: min(85vw, 750px);
            height: min(85vw, 750px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.03;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .bg-pentagram svg {
            width: 100%;
            height: 100%;
            fill: #ffffff;
        }

        header, main, footer {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 960px;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 1px solid rgba(197, 160, 89, 0.2);
            padding-bottom: 30px;
        }

        /* Container do Altar (Vela e Caveiras Flanqueando) */
        .altar-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            margin-bottom: 25px;
        }

        /* Estilo Realista das Caveiras Laterais */
        .skull-element {
            width: 55px;
            height: 70px;
            opacity: 0.9;
            filter: drop-shadow(0 0 10px rgba(197, 160, 89, 0.4));
            animation: skullGlow 3s infinite alternate;
        }

        @keyframes skullGlow {
            0% { filter: drop-shadow(0 0 6px rgba(197, 160, 89, 0.3)); opacity: 0.8; }
            100% { filter: drop-shadow(0 0 15px rgba(230, 202, 132, 0.7)); opacity: 1; }
        }

        /* Vela Mística Integrada com UI Otimizada */
        .candle-container {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .glow {
            position: absolute;
            top: -40px;
            width: 120px;
            height: 120px;
            background: radial-gradient(circle, rgba(255,150,50,0.3) 0%, rgba(255,100,0,0) 70%);
            border-radius: 50%;
            animation: pulse 2s infinite alternate;
            pointer-events: none;
        }

        .flame-wrapper {
            position: relative;
            animation: flicker 0.15s ease-in-out infinite alternate;
        }

        .flame {
            width: 20px;
            height: 50px;
            background: linear-gradient(to bottom, #fff 0%, #ffdf00 25%, #ff4500 70%, #0000ff 100%);
            border-radius: 50% 50% 35% 35% / 70% 70% 30% 30%;
            box-shadow: 0 0 15px rgba(255, 69, 0, 0.5);
            transform-origin: bottom center;
        }

        .wick {
            width: 3px;
            height: 12px;
            background-color: #333;
            border-radius: 2px;
            margin-top: -2px;
            z-index: 2;
        }

        .wax {
            width: 45px;
            height: 120px;
            background: linear-gradient(to right, #4f0272 0%, #62026b 30%, #62026b 70%, #62026b 100%);
            border-radius: 4px 4px 2px 2px;
            box-shadow: inset 0 10px 15px rgba(255, 255, 255, 0.3), 0 5px 20px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        .wax::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background-color: #ff9d6c;
            border-radius: 50%;
        }

        .drip {
            position: absolute;
            top: 4px;
            left: 10px;
            width: 5px;
            height: 25px;
            background-color: #ff9d6c;
            border-radius: 0 0 4px 4px;
        }

        @keyframes flicker {
            0% { transform: scale(1) rotate(-1deg); }
            100% { transform: scale(1.05) rotate(1.5deg); }
        }

        @keyframes pulse {
            0% { transform: scale(0.95); opacity: 0.8; }
            100% { transform: scale(1.05); opacity: 1; }
        }

        /* Título com Reluz e Brilho Dourado Dinâmico */
        h1 {
            font-family: 'Cinzel', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.2rem);
            font-weight: 900;
            letter-spacing: 3px;
            background: linear-gradient(135deg, #fff3c4 0%, #ffe885 25%, #c5a059 50%, #fff3c4 75%, #8c7131 100%);
            background-size: 250% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px rgba(243, 229, 171, 0.4);
            animation: goldShimmer 4s ease infinite;
            margin-bottom: 8px;
        }

        @keyframes goldShimmer {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        p.subtitle {
            color: var(--text-muted);
            font-style: italic;
            font-size: 1.15rem;
            letter-spacing: 1px;
            font-family: 'Cinzel', serif;
        }

        main {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-gold);
            border-radius: 8px;
            padding: 35px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.7), inset 0 0 20px rgba(197, 160, 89, 0.03);
        }

        .panel h2 {
            font-family: 'Cinzel', serif;
            color: var(--border-gold-bright);
            font-size: 1.4rem;
            margin-bottom: 15px;
            border-bottom: 1px solid rgba(197, 160, 89, 0.2);
            padding-bottom: 10px;
            letter-spacing: 1px;
        }

        .panel p.instruction {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        textarea {
            width: 100%;
            background-color: #030305;
            border: 1px solid var(--border-gold);
            color: var(--text-color);
            padding: 16px;
            border-radius: 6px;
            font-size: 1.15rem;
            resize: vertical;
            min-height: 120px;
            outline: none;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 6px rgba(0,0,0,0.6);
        }

        textarea:focus {
            border-color: var(--border-gold-bright);
            box-shadow: 0 0 12px var(--accent-glow), inset 0 2px 6px rgba(0,0,0,0.6);
        }

        .btn-group {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .btn {
            font-family: 'Cinzel', serif;
            background: linear-gradient(135deg, var(--gold-dark), var(--border-gold), var(--border-gold-bright));
            color: #050507;
            font-weight: 700;
            border: none;
            padding: 14px 28px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1.05rem;
            letter-spacing: 1.5px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(197, 160, 89, 0.2);
            display: inline-block;
        }

        .btn:hover {
            filter: brightness(1.15);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(197, 160, 89, 0.4);
        }

        .btn-secondary {
            font-family: 'Cinzel', serif;
            background: transparent;
            color: var(--border-gold);
            border: 1px solid var(--border-gold);
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.95rem;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            background: rgba(197, 160, 89, 0.1);
            color: var(--border-gold-bright);
            border-color: var(--border-gold-bright);
        }

        .reading-area {
            display: flex;
            flex-direction: column;
            gap: 25px;
            margin-top: 15px;
        }

        .question-echo {
            font-style: italic;
            color: var(--border-gold-bright);
            font-size: 1.25rem;
            padding: 12px 18px;
            background: rgba(197, 160, 89, 0.04);
            border-left: 3px solid var(--border-gold);
            border-radius: 0 4px 4px 0;
            margin-bottom: 10px;
        }

        .cards-spread {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card-slot {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .card-position-label {
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .marsille-card {
            width: 150px;
            height: 245px;
            background-color: #0c0c10;
            border: 3px solid var(--border-gold);
            border-radius: 8px;
            padding: 6px;
            position: relative;
            box-shadow: 0 8px 25px rgba(0,0,0,0.6), inset 0 0 12px rgba(197, 160, 89, 0.15);
            animation: cardAppear 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
            overflow: hidden;
        }

        .marsille-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 4px;
        }

        .interpretation-box {
            background-color: #030305;
            border: 1px solid var(--border-gold);
            border-left: 4px solid var(--border-gold-bright);
            padding: 25px;
            border-radius: 6px;
            width: 100%;
            margin-top: 10px;
            line-height: 1.8;
            font-size: 1.15rem;
        }

        .interpretation-box h3 {
            font-family: 'Cinzel', serif;
            color: var(--border-gold-bright);
            margin-bottom: 12px;
            font-size: 1.25rem;
            letter-spacing: 1px;
        }

        .pix-box-content {
            background: rgba(3, 3, 5, 0.6);
            border: 1px dashed var(--border-gold);
            padding: 20px;
            border-radius: 6px;
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
        }

        .pix-key-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            word-break: break-all;
            font-family: 'Cinzel', serif;
            color: var(--border-gold-bright);
        }

        .btn-elaborated {
            font-family: 'Cinzel', serif;
            background: linear-gradient(135deg, #8c7131, #c5a059, #fff3c4);
            color: #050507;
            font-weight: 700;
            text-decoration: none;
            border: none;
            padding: 16px 32px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1.1rem;
            letter-spacing: 2px;
            display: inline-block;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(197, 160, 89, 0.3);
            text-transform: uppercase;
            text-align: center;
        }

        .btn-elaborated:hover {
           filter: brightness(1.2);
           transform: translateY(-3px);
           box-shadow: 0 6px 25px rgba(197, 160, 89, 0.5);
        }

        .back-to-top-container {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        @keyframes cardAppear {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        footer {
            margin-top: 60px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-family: 'Cinzel', serif;
            border-top: 1px solid rgba(197, 160, 89, 0.2);
            padding-top: 25px;
            letter-spacing: 1px;
            line-height: 1.6;
        }

        @media (max-width: 600px) {
            .marsille-card {
                width: 125px;
                height: 205px;
            }
            .panel {
                padding: 20px;
            }
            .altar-container {
                gap: 20px;
            }
            .skull-element {
                width: 42px;
                height: 55px;
            }
        }
    </style>
</head>
