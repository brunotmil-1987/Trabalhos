        function sortearCartas(qtd) {
            let deckCopia = [...tarotDeck];
            let sorteadas = [];
            for (let i = 0; i < qtd; i++) {
                let index = Math.floor(Math.random() * deckCopia.length);
                sorteadas.push(deckCopia.splice(index, 1)[0]);
            }
            return sorteadas;
        }

        function consultarOraculo(qtdCartas) {
            const perguntaInput = document.getElementById("user-question");
            const pergunta = perguntaInput.value.trim();

            if (!pergunta) {
                alert("Por favor, formule sua pergunta para que Morgana de Hecate consulte as cartas.");
                perguntaInput.focus();
                return;
            }

            const resultPanel = document.getElementById("result-panel");
            resultPanel.style.display = "block";
            document.getElementById("echo-question").innerText = `"${pergunta}"`;

            const cartasSorteadas = sortearCartas(qtdCartas);
            const spreadContainer = document.getElementById("cards-spread");
            spreadContainer.innerHTML = "";

            let posicoes = qtdCartas === 4 ? ["Passado", "Presente", "Agora", "Futuro"] : ["Passado / Raiz", "Presente / Momento", "Futuro / Destino"];

            cartasSorteadas.forEach((carta, index) => {
                const cardSlot = document.createElement("div");
                cardSlot.className = "card-slot";
                cardSlot.style.animationDelay = `${index * 0.2}s`;
                cardSlot.innerHTML = `
                    <span class="card-position-label">${posicoes[index]}</span>
                    <div class="marsille-card">
                        <img src="${carta.image}" alt="${carta.name}">
                    </div>
                `;
                spreadContainer.appendChild(cardSlot);
            });

            let interpretacaoTexto = "";
            if (qtdCartas === 4) {
                interpretacaoTexto = `A Cartomante Morgana de Hecate examina a Tiragem Aprofundada e revela que no *Passado* a energia de *${cartasSorteadas[0].name}* influenciou os alicerces, mostrando que ${cartasSorteadas[0].meaning.toLowerCase()} No *Presente*, a carta *${cartasSorteadas[1].name}* traz o panorama atual onde ${cartasSorteadas[1].meaning.toLowerCase()} No *Agora* (o ponto de virada imediato), a força de *${cartasSorteadas[2].name}* indica que ${cartasSorteadas[2].meaning.toLowerCase()} Por fim, olhando para o *Futuro*, a carta *${cartasSorteadas[3].name}* aponta que o destino tende a caminhar para ${cartasSorteadas[3].meaning.toLowerCase()} Conduza suas escolhas com lucidez.`;
            } else {
                interpretacaoTexto = `A Cartomante Morgana de Hecate observa que no passado a energia da carta *${cartasSorteadas[0].name}* estabeleceu as bases, indicando que ${cartasSorteadas[0].meaning.toLowerCase()} No momento presente, a presença de *${cartasSorteadas[1].name}* atua diretamente, revelando que ${cartasSorteadas[1].meaning.toLowerCase()} Por fim, o horizonte aponta para a carta *${cartasSorteadas[2].name}*, mostrando que o desfecho tende a caminhar para ${cartasSorteadas[2].meaning.toLowerCase()} Mantenha sua intuição clara e utilize estas chaves com sabedoria.`;
            }

            document.getElementById("interpretation-text").innerText = interpretacaoTexto;
            resultPanel.scrollIntoView({ behavior: 'smooth' });
        }

        function copiarPixKey(chave) {
            navigator.clipboard.writeText(chave).then(() => {
                const btn = document.getElementById("copy-btn");
                btn.innerText = "Copiado! ✓";
                setTimeout(() => {
                    btn.innerText = "Copiar Chave";
                }, 2500);
            }).catch(err => {
                console.error('Erro ao copiar chave Pix: ', err);
            });
        }

        function voltarAoTopo() {
            document.getElementById("topo").scrollIntoView({ behavior: 'smooth' });
            document.getElementById("user-question").focus();
        }
